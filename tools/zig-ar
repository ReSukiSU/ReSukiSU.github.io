#!/usr/bin/env sh

set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

case "$(uname -m)" in
  aarch64 | arm64)
    zig="$repository_root/node_modules/@oven/zig-linux-arm64/zig"
    ;;
  x86_64 | amd64)
    zig="$repository_root/node_modules/@oven/zig-linux-x64/zig"
    ;;
  *)
    echo "Unsupported Linux architecture: $(uname -m)" >&2
    exit 1
    ;;
esac

exec "$zig" ar "$@"

